# =============================================================================
# FFA — Configuración de infraestructura
# Copiá a .env y ajustá según tu entorno.
# =============================================================================

# Perfil predefinido (aplica defaults; cada variable abajo puede sobreescribir):
#   minimal — sin Docker: disco local + cola inline + Mongo en memoria
#   docker  — docker compose (Mongo, Redis, MinIO, Mailhog)
#   native  — servicios instalados en el SO (Mongo/Redis/MinIO locales)
#   cloud   — S3 + Mongo/Redis gestionados en nube
FFA_PROFILE=minimal

NODE_ENV=development
DEPLOYMENT_MODE=hybrid

# --- API ---
PORT=3005
# API_PORT=3005
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@ecr-salud.local
SEED_ADMIN_PASSWORD=Admin123!

# --- Almacenamiento ---
# local = carpeta en disco | s3 = MinIO o AWS S3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# Solo si STORAGE_BACKEND=s3 (perfil docker/native/cloud):
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=ffa_minio
# S3_SECRET_KEY=ffa_minio_secret
# S3_BUCKET=ffa-documents
# S3_REGION=us-east-1

# --- Colas del pipeline ---
# inline = procesa en la API (sin Redis) | redis = BullMQ + worker
QUEUE_BACKEND=inline

# Solo si QUEUE_BACKEND=redis:
# REDIS_URL=redis://localhost:6379

# --- MongoDB ---
# uri = MongoDB local o remoto (recomendado) | memory = RAM, no persiste (solo pruebas)
MONGODB_BACKEND=uri
MONGODB_URI=mongodb://127.0.0.1:27017/ffa
# Docker: mongodb://ffa:ffa_dev@localhost:27017/ffa?authSource=admin

# --- Correo / ingesta ---
# off | mailhog | imap | smtp
MAIL_BACKEND=off
# MAIL_POLL_MS=30000
# MAILHOG_API=http://localhost:8025/api/v2
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=ffa@ecr-salud.local
# EMAIL_IMAP_HOST=
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASSWORD=

# --- Extracción IA (opcional; por defecto mock en seed) ---
# OPENAI_API_KEY=
# OPENAI_EXTRACT_MODEL=gpt-4o-mini
# OPENAI_PDF_MAX_PAGES=6
# OPENAI_REQUEST_TIMEOUT_MS=180000
# Fallback automático OpenAI → Anthropic si OpenAI falla:
# ANTHROPIC_API_KEY=
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-4-6
# ANTHROPIC_PDF_MAX_PAGES=6
# ANTHROPIC_REQUEST_TIMEOUT_MS=180000
