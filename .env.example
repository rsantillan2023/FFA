# =============================================================================
# FFA — Configuración de infraestructura
# Copiá a .env y ajustá según tu entorno.
# =============================================================================

# Perfil predefinido (aplica defaults; cada variable abajo puede sobreescribir):
#   minimal — sin Docker: disco local + cola inline + Mongo en memoria
#   docker  — docker compose (Mongo, Redis, MinIO, Mailhog)
#   native  — servicios instalados en el SO (Mongo/Redis/MinIO locales)
#   cloud   — S3 + Mongo/Redis gestionados en nube
FFA_PROFILE=minimal

NODE_ENV=development
DEPLOYMENT_MODE=hybrid

# --- API ---
PORT=3005
# API_PORT=3005
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@ecr-salud.local
SEED_ADMIN_PASSWORD=Admin123!

# --- Almacenamiento ---
# local = carpeta en disco | s3 = MinIO o AWS S3
STORAGE_BACKEND=local
# Ruta relativa al monorepo (funciona desde raíz o apps/api)
LOCAL_STORAGE_PATH=apps/api/data/storage

# Solo si STORAGE_BACKEND=s3 (perfil docker/native/cloud):
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=ffa_minio
# S3_SECRET_KEY=ffa_minio_secret
# S3_BUCKET=ffa-documents
# S3_REGION=us-east-1

# --- Colas del pipeline ---
# inline = procesa en la API (sin Redis) | redis = BullMQ + worker
QUEUE_BACKEND=inline

# Preprocesos en paralelo (inline y worker redis). Default: 3
PREPROCESS_CONCURRENCY=3

# Solo si QUEUE_BACKEND=redis:
# REDIS_URL=redis://localhost:6379

# --- MongoDB ---
# uri = MongoDB local o remoto (recomendado) | memory = RAM, no persiste (solo pruebas)
MONGODB_BACKEND=uri
MONGODB_URI=mongodb://127.0.0.1:27017/ffa
# Docker: mongodb://ffa:ffa_dev@localhost:27017/ffa?authSource=admin

# --- Correo / ingesta ---
# off | mailhog | imap | smtp
MAIL_BACKEND=off
# MAIL_POLL_MS=30000
# MAILHOG_API=http://localhost:8025/api/v2
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=ffa@ecr-salud.local
# EMAIL_IMAP_HOST=
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASSWORD=

# --- Extracción IA (Anthropic primero — ver docs/SOLUCION-UNIFICADA-IA.md) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-4-6
# ANTHROPIC_PDF_MAX_PAGES=24
# ANTHROPIC_REQUEST_TIMEOUT_MS=180000
# OPENAI_API_KEY=
# OPENAI_EXTRACT_MODEL=gpt-4o-mini
# OPENAI_PDF_MAX_PAGES=24
# OPENAI_REQUEST_TIMEOUT_MS=180000
# PDF ≤ N páginas → todas a Vision (sin smart selection)
# EXTRACT_SHORT_PDF_ALL_PAGES=6
# Complemento regex post-extract (0 = desactivado, preferido con Claude)
# EXTRACT_HEURISTIC_COMPLEMENT=0
# Gap-fill desde texto escaneado cuando Vision omite filas (default: activo)
# EXTRACT_AUTO_COMPLEMENT=1
# PDF corto nativo: texto escaneado como fuente primaria (corrige Vision)
# EXTRACT_NATIVE_PRIMARY=1
# EXTRACT_NATIVE_MIN_CHARS=120
# --- Clasificación IA (F2: Claude-first en worker classify) ---
# ANTHROPIC_CLASIFICACION_MODEL=claude-sonnet-4-6
# OPENAI_CLASIFICACION_MODEL=gpt-4o-mini
# CLASIFICACION_IA_ENABLED=1
# CLASIFICACION_IA_CONCURRENCY=5
# CLASIFICACION_IA_TIMEOUT_MS=90000
# Umbral confianza para marcar línea IA como OK sin revisión manual (default 70)
# UMBRAL_OK_IA=70
# --- F3: mapa Claude PDF largo + diagnóstico cuadratura ---
# PDF_CLAUDE_PAGE_MAP=1
# PDF_CLAUDE_MAP_MIN_PAGES=20
# PDF_CLAUDE_MAP_TIMEOUT_MS=120000
# PDF_SMART_PAGE_SELECTION=1
# EXTRACT_HARD_MAX_PAGES=16
# EXTRACT_EARLY_ABORT_EMPTY_PAGES=4
# CUADRATURA_IA_DIAGNOSTICO=1
# CUADRATURA_IA_TIMEOUT_MS=90000
